<section class="pagination">
    <ul>
        <% if (hasPreviousPage) { %>
            <a href="?page=<%= previousPage %>">Previous</a>
            <% } %>
                <% for (let i=1; i <=totalPages; i++) { %>
                    <a class="<%= currentPage == i ? 'active' : '' %>" href="?page=<%= i %>">
                        <%= i %>
                    </a>
                    <% } %>
                        <% if (hasNextPage) { %>
                            <a href="?page=<%= nextPage %>">Next</a>
                            <% } %>
    </ul>
</section>